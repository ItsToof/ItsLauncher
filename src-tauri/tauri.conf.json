{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ItsLauncher",
  "version": "1.1.1",
  "identifier": "com.itslauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ItsLauncher",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false,
        "center": true,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
